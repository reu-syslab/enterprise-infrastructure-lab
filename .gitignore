# Defense in depth only. Real environment data belongs OUTSIDE this checkout.
# Ignoring a path does not remove already tracked content.

# Local/private inputs and identities
.env
.env.*
!.env.example
*.local
*.local.*
/private/
/secrets/
/environments/
/inventory/
/inventories/
/data/*
!/data/example/
!/data/README.md
**/.ssh/
**/.kube/
**/.aws/
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.vault
*.age
*.jks
id_rsa*
id_ed25519*

# Terraform runtime, environment inputs, plans and crash output
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
*.plan
plan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Commit .terraform.lock.hcl later after an approved provider choice.

# Device exports, captures, backups, logs and generated private evidence
*.backup
*.bak
*.rsc
*.conf
*.cfg
*.ovpn
*.rdp
*.pcap
*.pcapng
*.log
*.evtx
*.etl
*.dmp
*.iso
*.vhd
*.vhdx
*.qcow2
*.vma*
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
/backups/
/exports/
/artifacts/
/reports/
*.retry

# Local tooling
__pycache__/
*.pyc
.venv/
node_modules/
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
.pve-live-sync/
